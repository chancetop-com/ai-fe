{
  "name": "@connexup/ai-chat",
  "version": "1.1.5",
  "description": "AI chat UI with native HTML, powered by @connexup/ai-api and @connexup/ai-react",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "private": false,
  "scripts": {
    "dev": "pnpm run dev:css & tsup src/index.ts --format esm --dts --watch --external react --external react-dom --external @connexup/ai-api --external @connexup/ai-react --external lucide-react --external react-markdown --external remark-gfm",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build": "pnpm run clean && pnpm run build:css && tsup src/index.ts --format esm --dts --external react --external react-dom --external @connexup/ai-api --external @connexup/ai-react --external lucide-react --external react-markdown --external remark-gfm",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@connexup/ai-api": "workspace:*",
    "@connexup/ai-react": "workspace:*",
    "lucide-react": "^0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-markdown": "^9.0.0 || ^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@connexup/ai-api": "workspace:*",
    "@connexup/ai-react": "workspace:*",
    "@connexup/eslint-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
